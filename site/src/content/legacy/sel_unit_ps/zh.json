.0.0~232.0</div>\n                          </div>\n\n                          <div class=\"row setp_space_top setp_space_bottom\">\n                          \t<div class=\"col-sm-4 vc_center\"><p>Acceptance Factor</p></div>\n                            <div class=\"col-sm-4\">\n                                <div class=\"form-control AF_bg text-center\" id=\"out_Acceptance_Factor_PSI\"></div>\n                                <input id=\"val_Acceptance_Factor_PSI\" name=\"val_Acceptance_Factor_PSI\" type=\"hidden\" value=\"\">\n                            </div>\n                            <div class=\"col-sm-4 vc_center\"><p>OUT>IN</p></div>\n                          </div>\n\n                    </div>\n                </div>\n              </div>\n\t\t\t  <div class=\"step_arrow_down\"><img src=\"/images/arrow_down.jpg\" width=\"78\" height=\"66\"></div>\n\n\t\t\t  <div class=\"row\">\n              \t<div class=\"col-sm-3\">\n                \t<div class=\"step_style-1\"><p>STEP 3</p></div>\n                </div>\n              \t<div class=\"col-sm-9\">\n                    <div class=\"step_style-2\">\n                    \t<div class=\"step_bottom_border\">FINDIND WATER FLOW</div>\n\n                          <div class=\"row setp_space_top\">\n                          \t<div class=\"col-sm-4 vc_center\"><p>Minimum Run Time</p></div>\n                            <div class=\"col-sm-4\"><input id=\"input_Minimum_PSI\" name=\"input_Minimum_PSI\" type=\"number\" class=\"form-control text-center\" value=\"1\" maxlength=\"1\" min=\"1\" max=\"4\"></div>\n                            <div class=\"col-sm-4 vc_center\"><p>min 1~4</p></div>\n                          </div>\n\n                          <div class=\"row setp_space_top\">\n                          \t<div class=\"col-sm-4 vc_center\"><p>Litre per Minute</p></div>\n                            <div class=\"col-sm-4\"><input id=\"input_Litre_PSI\" name=\"input_Litre_PSI\" type=\"number\" class=\"form-control text-center\" value=\"1\" maxlength=\"3\" min=\"1\" max=\"100\"></div>\n                            <div class=\"col-sm-4 vc_center\"><p>L 1~100</p></div>\n                          </div>\n\n                          <div class=\"row setp_space_top setp_space_bottom\">\n                          \t<div class=\"col-sm-4 vc_center\"><p>Total Water Needed</p></div>\n                            <div class=\"col-sm-4\">\n                            \t<div id=\"out_total_WN_PSI\" class=\"form-control AF_bg text-center\"></div>\n                            \t<input id=\"input_Total_WN_PSI\" name=\"input_Total_WN_PSI\" type=\"hidden\" value=\"\">\n                            </div>\n                            <div class=\"col-sm-4 vc_center\"><p>L</p></div>\n                          </div>\n\n                    </div>\n                </div>\n              </div>\n\n              <div class=\"step_arrow_down\"><img src=\"/images/arrow_down.jpg\" width=\"78\" height=\"66\"></div>\n\n</div>\n<div class=\"col-md-6 px-0\">\n\n\t\t\t  <div class=\"row\">\n              \t<div class=\"col-sm-3\">\n                \t<div class=\"step_style-1\"><p>STEP 4</p></div>\n                </div>\n              \t<div class=\"col-sm-9\">\n                    <div class=\"step_style-2\">\n                    \t<div class=\"step_bottom_border\">PROPER TANK SIZE</div>\n\n                          <div class=\"row setp_space_top\">\n                          \t<div class=\"col-sm-4\"></div>\n                            <div class=\"col-sm-4\">\n                            \t<div id=\"out_proper_tank_size_PSI\" class=\"form-control AF_bg text-center step4_txt_1\"></div>\n                                 <input id=\"input_proper_tank_size_PSI\" name=\"input_proper_tank_size_PSI\" type=\"hidden\" value=\"\">\n\n                            </div>\n                            <div class=\"col-sm-4 step4_txt_2 vc_center\"><p>L, or above</p></div>\n                          </div>\n\n     