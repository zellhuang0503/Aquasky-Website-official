  "bodyHtml": "<div id=\"cerfitication-container\" class=\"container-fluid lang_rtl\">\n<h1 id=\"about-top-title\" class=\"h1-1\">الشهادة</h1>\n<div class=\"cf_link_area\">\n<div class=\"container\">\n<div class=\"cerfitication_spacing\"></div>\n    <div class=\"row\">\n            <div class=\"col-md-7\">\n                <div class=\"row\">\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_1\">\n                        <img src=\"/images/CERTIFICATION/icon/img_01.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">شهادة الالتزام الأوروبية CE</p>\n                        </a>\n                    </div>\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_2\">\n                    \t<img src=\"/images/CERTIFICATION/icon/img_02.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">المؤسسة الوطنية للصحة العامة NSF</p>\n                        </a>\n                    </div>\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_3\">\n                    \t<img src=\"/images/CERTIFICATION/icon/img_03.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">المؤسسة الوطنية للصحة العامة NSF</p>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_4\">\n                        <img src=\"/images/CERTIFICATION/icon/img_04.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">نظام إدارة الجودة ISO 9001:2015//Eurocert </p>\n                        </a>\n                    </div>\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_5\">\n                        <img src=\"/images/CERTIFICATION/icon/img_05.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">القانون الموحد للسباكة (UPC)</p>\n                        </a>\n                    </div>\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_6\">\n                        <img src=\"/images/CERTIFICATION/icon/img_06.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">شهادة KC (شهادة علامة KC الكورية)</p>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_7\">\n                        <img src=\"/images/CERTIFICATION/icon/img_07.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">شهادة ACS الفرنسية للمياه الصالحة للشرب</p>\n                        </a>\n                    </div>\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_8\">\n                    \t<img src=\"/images/CERTIFICATION/icon/img_08.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">شهادة WRAS البريطانية لأوعية المياه الصالحة للشرب</p>\n                        </a>\n                    </div>\n                    <div class=\"col-xs-4\">\n                    \t<a href=\"/ar/certification#si_9\">\n                    \t<img src=\"/images/CERTIFICATION/icon/img_09_2025.png\" border=\"0\" class=\"img-responsive center-block\" alt=\"\">\n                    \t<p class=\"cf_link_icon_txt\">شهادة ووتر مارك لأوعية المياه الصالحة للشرب في أستراليا WaterMark</p>\n                        </a>\n                    </div>\n                </div>\n             </div>\n     </div>\n     <div class=\"cerfitication_spacing\"></div>\n</div>\n\n</div>\n<div class=\"cerfitication_spacing\"></div>\n\n    <div class=\"cerfitication_spacing\"></div>\n\n    \t<div id=\"cf_area_Asia\" class=\"container cf_area_c\" style=\"\">\n\n                <a name=\"si_1\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/CE.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"شهادة الالتزام الأوروبية CE\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/ce_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                شهادة الالتزام الأوروبية CE                </h3>\n            \t<div class=\"cf_content\">\n                <p>تعليمات معدات الضغط بالانجليزية Pressure Equipment Directive 2014/68/EU (PED) للاتحاد الأوروبي المعايير الخاصة بتصميم وتصنيع معدات الضغط التي تتجاوز عادة حجم لتر واحد وتحتوي على ضغط أقصى يزيد عن 0.5 بار مقياس. كما تحدد المتطلبات الإدارية لإجراءات &quot;تقييم الموافقة&quot; لمعدات الضغط، من أجل وضعها بحرية في السوق الأوروبية دون حواجز تشريعية محلية. &lrm;جميع خزانات الضغط Aquasky معتمدة من قبل PED وتم صنعها بواسطة لحام معتمد من PED.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"https://www.certipedia.com/quality_marks/9108658013?locale=en&certificate_number=01+202+TWN%2FQ-19+0360\" target=\"_blank\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_2\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/NSF58.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"المؤسسة الوطنية للصحة العامة NSF58 （NSF/ANSI 58）\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/nsf_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                المؤسسة الوطنية للصحة العامة NSF58 （NSF/ANSI 58）                </h3>\n            \t<div class=\"cf_content\">\n                <p>NSF/ANSI 58 تحدد الحد الأدنى من المتطلبات للحصول على شهادة أنظمة الأوزموز العكسي المستخدمة في نقاط الاستخدام (POU) والمصممة لتقليل الملوثات التي قد تكون موجودة في مياه الشرب العامة أو الخاصة. &lrm;تشمل نطاق NSF/ANSI 58 سلامة المواد، والنزاهة الهيكلية، وتقليل المواد الصلبة المذابة (TDS)، وغيرها من المطالبات الاختيارية لتقليل الملوثات. أكثر المطالبات الاختيارية شيوعًا التي يتناولها NSF/ANSI 58 تشمل تقليل الكيست، وتقليل الكروم السداسي والثلاثي، وتقليل الزرنيخ، وتقليل النترات/النتريت، وتقليل الكادميوم والرصاص.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"http://info.nsf.org/Certified/DWTU/Listings.asp?Company=12210&Standard=058\" target=\"_blank\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_3\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/NSF61-20210207.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"المؤسسة الوطنية للصحة العامة NSF61（NSF/ANSI 61）\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/nsf61_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                المؤسسة الوطنية للصحة العامة NSF61（NSF/ANSI 61）                </h3>\n            \t<div class=\"cf_content\">\n                <p>NSF/ANSI 61 تضمن أن منتجك يلبي متطلبات التنظيم للولايات المتحدة وكندا، وغالبًا ما يمكن أن يلبي أو يوفي بمتطلبات الاختبار للعديد من الدول الأخرى أيضًا. الشركات الرائدة في السوق تسعى للحصول على الشهادة من NSF كعلامة تميز توفر لعملائها الضمان بأن المنتج آمن للاستخدام في مياه الشرب. اختبارات NSF/ANSI 61 تغطي جميع المنتجات التي تكون في اتصال مع مياه الشرب من المصدر إلى الصنبور، وتحدد أي الملوثات قد تنتقل أو تتسرب من منتجك إلى مياه الشرب. كما تؤكد إذا كانت تلك الملوثات أدنى من الحد الأقصى المسموح به لتعتبر آمنة.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"https://plm.iapmo.org/pld#/certificate/N-7370/1883\" target=\"_blank\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_4\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/20241209_EUROCERT-IOS9001.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"نظام إدارة الجودة ISO 9001:2015\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/eurocert_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                نظام إدارة الجودة ISO 9001:2015                </h3>\n            \t<div class=\"cf_content\">\n                <p>ISO 9001:2015 تحدد المعايير لنظام إدارة الجودة وهي المعيار الوحيد في العائلة الذي يمكن الحصول عليه بشهادة (على الرغم من أن هذا ليس شرطًا). يمكن استخدامها من قبل أي منظمة، كبيرة أو صغيرة، بغض النظر عن مجال نشاطها. يعتمد هذا المعيار على عدد من مبادئ إدارة الجودة بما في ذلك التركيز القوي على العميل، وتحفيز ومشاركة الإدارة العليا، والنهج العملي، والتحسين المستمر.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"/ar/certification-page/iso-9001-eurocert\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_5\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/UPC.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"القانون الموحد للسباكة (UPC)\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/upc_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                القانون الموحد للسباكة (UPC)                </h3>\n            \t<div class=\"cf_content\">\n                <p>الرمز الموحد للسباكة (UPC) &lrm;علامة شهادة UPC تضمن وظيفة وأمان خزان الضغط Aquasky. خزانات المياه الصالحة للشرب المضغوطة مسبقًا مع حاجز بين جزء المياه والهواء من الخزان. يجب تثبيتها وفقًا لتعليمات الشركة المصنعة ومتطلبات أحدث طبعة من الرمز الموحد للسباكة. تم اختبار المنتجات المدرجة في هذه الشهادة من قبل مختبر معترف به من قبل IAPMO R&amp;T. تم منح هذا الاعتراف.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"https://plm.iapmo.org/pld#/certificate/4837/1882\" target=\"_blank\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_6\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/%E9%9F%93%E6%96%87%E8%AA%8D%E8%AD%89.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"شهادة KC (شهادة علامة KC الكورية)\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/kc_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                شهادة KC (شهادة علامة KC الكورية)                </h3>\n            \t<div class=\"cf_content\">\n                <p>شهادة علامة KC الكورية &lrm;تشير علامة KC (شهادة كوريا) إلى الامتثال لمتطلبات الأمان المنتج في كوريا لمعدات الضغط وتصدر من قبل هيئات الشهادة التي مقرها في كوريا التي تمت الموافقة عليها من قبل جمعية معايير كوريا. يمكن للمصنعين وموزعي معدات الضغط تطبيق علامة KC على سلعهم بمجرد أن يكملوا الإجراء القياسي.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"/ar/certification-page/kc-korea\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_7\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/20251205_Aquasky%20ACS%20p1.jpg\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"شهادة ACS الفرنسية للمياه الصالحة للشرب\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/acs_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                شهادة ACS الفرنسية للمياه الصالحة للشرب                </h3>\n            \t<div class=\"cf_content\">\n                <p>ACS هي هيئات الشهادة الصحية الفرنسية، تعتمد بشكل رئيسي على المعايير التي أعلنتها AFNOR (الرابطة الفرنسية للتقييس) لاختبار منتجات السباكة. يجب أن تكون أي أداة أو ملحق يكون في اتصال مع المياه الصالحة للشرب معتمدة من ACS في فرنسا.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"/ar/certification-page/acs-france\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_8\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/Under%20Process.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"شهادة WRAS البريطانية لأوعية المياه الصالحة للشرب\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/wars_b.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                شهادة WRAS البريطانية لأوعية المياه الصالحة للشرب                </h3>\n            \t<div class=\"cf_content\">\n                <p>تعزز وتضمن WRAS الالتزام بلوائح إمدادات المياه (تجهيزات المياه) في إنجلترا وويلز، والقوانين المائية المكافئة في اسكتلندا وأيرلندا الشمالية.&lrm;يغطي نظام الموافقة أيضًا المكونات والمواد غير المعدنية (مثل الواشرات المطاطية والجوانات)، التي تخضع للاختبار لتحديد تأثيرها على المياه التي تأتي في اتصال معها.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"/ar/certification-page/wras-uk\" class=\"btn btn-link\">رابط الشهادات</a>    \n                    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_9\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/20251127_WaterMark-1.jpg\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"شهادة ووتر مارك لأوعية المياه الصالحة للشرب في أستراليا WaterMark\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/2025-WaterMark%20LF(1).png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                شهادة ووتر مارك لأوعية المياه الصالحة للشرب في أستراليا WaterMark                </h3>\n            \t<div class=\"cf_content\">\n                <p>نظام شهادة WaterMark هو نظام شهادة إلزامي لمنتجات السباكة والصرف الصحي. &lrm;يضمن أن المنتجات تتوافق مع رمز السباكة في أستراليا، وهي مناسبة للاستخدام، وتلبي المعايير الأسترالية المتعلقة بجودة المنتج، بما في ذلك الصحة والسلامة. يمكن قبول المنتج الذي عليه علامة شهادة WaterMark في جميع أنحاء أستراليا.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"/ar/certification-page/watermark-australia\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_10\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/20220802Singapore%20PSB%20certification.jpg\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"شهادة PSB سنغافورة\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                                </div>\n            \t<h3 class=\"cf_name\">\n                شهادة PSB سنغافورة                </h3>\n            \t<div class=\"cf_content\">\n                <p>شهادة PSB في سنغافورة &lrm;المعايير في سنغافورة، وهي اللوائح حماية المنتجات الاستهلاكية في سنغافورة، تم تعيينها في عام 1911. شهادة PSB هي شهادة أمان إلزامية في سنغافورة. يمكن بيع المنتجات المسجلة التي تحمل شعار الأمان فقط في سنغافورة. يجب على الوحدات المعنية المسؤولة عن بيع السلع المنظمة للمستهلكين في سنغافورة تسجيل كل نموذج مع السلطة الأمنية.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"/ar/certification-page/psb-singapore\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n                <a name=\"si_11\"></a>\n        <div class=\"row\" style=\"padding:20px 0 30px 0;\">\n        \t<div class=\"col-md-4\" style=\"padding-bottom:25px;\">\n\n            \t<div class=\"cf_img\"><img src=\"/upfile/Images/CERTIFICATION/20231030_Listing%20Category%20_%20NSF%20372%20International.jpg\" border=\"0\" loading=\"lazy\" class=\"img-responsive center-block\" alt=\"NSF/ANSI 372 مكونات نظام المياه الصالحة للشرب - محتوى الرصاص\"></div>            </div>\n        \t<div class=\"col-md-6\">\n            \t<div>\n                <img src=\"/upfile/Images/CERTIFICATION/20231102_AQUASKY_icon_bl-NSF_large.png\" border=\"0\" loading=\"lazy\" class=\"img-responsive\">                </div>\n            \t<h3 class=\"cf_name\">\n                NSF/ANSI 372 مكونات نظام المياه الصالحة للشرب - محتوى الرصاص                </h3>\n            \t<div class=\"cf_content\">\n                <p dir=\"rtl\">يحدد القياس NSF/ANSI 372 الحدود لكمية الرصاص التي قد تكون موجودة في المواد التي تتواصل مع الماء ضمن مكونات نظام المياه الصالحة للشرب. يحدد هذا القياس أن يجب أن يتم شهادة المنتج بأنه يفي بمتوسط محتوى الرصاص الموزون الذي يبلغ &le;0.25% عندما يتعلق الأمر بالأسطح المبللة للأنابيب وتركيبات الأنابيب وتركيبات السباكة وأدوات السباكة. تضمن هذه المتطلبات أن هذه المكونات لا تساهم في مستويات ضارة من الرصاص في المياه الصالحة للشرب، مساعدة في حماية صحة الجمهور، خاصة في سياق المياه المستخدمة للشرب والطهي.</p>                </div>\n                <div class=\"pd-btn-info-link\">\n                <a href=\"https://info.nsf.org/Certified/Lead_Content/Listings.asp?Company=12210&Standard=372-DWTU\" target=\"_blank\" class=\"btn btn-link\">رابط الشهادات</a>    \t\t\t</div>\n            </div>\n        </div>\n            </div>\n\n<div class=\"cerfitication_spacing\"></div>\n</div>"
}
