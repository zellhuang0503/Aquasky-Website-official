iv>\n                    </div>\n            </div>\n\t\t\t<div class=\"feature_obj\" obj_id_name=\"obj_show4\">\n                \t<div class=\"img-change\">\n                    \t<div class=\"obj_img\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_05.png\" alt=\"\" loading=\"lazy\"></div>\n                    \t<div class=\"overlay\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_h_05.png\" alt=\"\" loading=\"lazy\"></div>\n                    </div>\n            </div>\n\t\t\t<div class=\"feature_obj_none\">\n                \t<div class=\"img-change\">\n                    \t<div class=\"obj_img\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_06.png\" alt=\"\" loading=\"lazy\"></div>\n                    \t<div class=\"overlay\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_h_06.png\" alt=\"\" loading=\"lazy\"></div>\n                    </div>\n            </div>\n\t\t\t<div class=\"feature_obj\" obj_id_name=\"obj_show5\">\n            \t\t<div class=\"img-change\">\n                    \t<div class=\"obj_img\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_07.png\" alt=\"\" loading=\"lazy\"></div>\n                        <div class=\"overlay\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_h_07.png\" alt=\"\" loading=\"lazy\"></div>\n                    </div>\n            </div>\n\t\t\t<div class=\"feature_obj\" obj_id_name=\"obj_show6\">\n                \t<div class=\"img-change\">\n                    \t<div class=\"obj_img\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_08.png\" alt=\"\" loading=\"lazy\"></div>\n                    \t<div class=\"overlay\"><img class=\"img-responsive\" src=\"/images/FEATURE/img_arxa/Featrue_h_08.png\" alt=\"\" loading=\"lazy\"></div>\n                    </div>\n            </div>\n        </div>\n        <div class=\"obj_show_area lang_rtl\">\n            <div id=