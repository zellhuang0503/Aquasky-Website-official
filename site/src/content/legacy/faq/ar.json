  "bodyHtml": "<div id=\"news-container\" class=\"container-fluid\">\n<div id=\"about-top-title\">الأسئلة المتكررة</div>\n\n<div class=\"container page_spacing lang_rtl\">\n\t<div class=\"row\">\n    \t<div class=\"col-md-1\"></div>\n\t\t<div class=\"col-md-10 block-bg-01\">\n\n            <h2 class=\"news-h2 news-line\">الشهادة</h2>\n<div class=\"row page_spacing-3\">\n\t<div class=\"col-md-3\"><img src=\"/images/FAQ/FAQ-01.png\" class=\"img-responsive center-block\" loading=\"lazy\"></div>\n    <div class=\"col-md-9\">\n    \t    \t<div class=\"news-title\">\n\n        \t\t<div class=\"row\">\n                    <div class=\"col-xs-2 col-md-2\"><img src=\"/images/FAQ/FAQ-08.png\" class=\"img-responsive center-block\" style=\"\" loading=\"lazy\"></div>\n                    <div class=\"col-xs-10 col-md-10\">هل تحمل خزانات الضغط AQUASKY العلامة \"CE\"</div>\n                </div>\n\n        </div>\n    \t<div id=\"collapse_qa_1\" aria-labelledby=\"qa_head_id_1\" >\n        \t<div class=\"news-content\">\n\t\t\t<p><meta charset=\"utf-8\" /><span style=\"font-size:12px;\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"EN-US\"><span segoe=\"\" style=\"font-family:\" ui=\"\">نعم، خزانات الضغط AQUASKY تتوافق مع التوجيه الأوروبي PED 2014/68 / EU (توجيهات معدات الضغط) وفقًا للمعيار EN 13831.</span></span></span></span></p>            </div>\n        </div>\n\n    \t<div class=\"news-title\">\n\n        \t\t<div class=\"row\">\n                    <div class=\"col-xs-2 col-md-2\"><img src=\"/images/FAQ/FAQ-08.png\" class=\"img-responsive center-block\" style=\"\" loading=\"lazy\"></div>\n                    <div class=\"col-xs-10 col-md-10\">ما هو NSF 61؟</div>\n                </div>\n\n        </div>\n    \t<div id=\"collapse_qa_4\" aria-labelledby=\"qa_head_id_4\" >\n        \t<div class=\"news-content\">\n\t\t\t<p><meta charset=\"utf-8\" /><span style=\"font-size:12px;\"><span lang=\"EN-US\"><span style=\"font-family:&quot;Segoe UI&quot;,sans-serif\">بشكل عام، يتعلق المعيار بالمواد المحددة التي تأتي في تماس مع أي نوع من مياه الشرب. يركز هذا المعيار على تقييم الملوثات أو الشوائب التي تنتقل إلى مياه الشرب، وأنشأ متطلبات الصحة للماء</span></span><span lang=\"EN-US\"><span style=\"font-family:&quot;Segoe UI&quot;,sans-serif\">.</span></span></span></p>            </div>\n        </div>\n\n    </div>\n</div>\n\n<h2 class=\"news-h2 news-line\">المنتجات</h2>\n<div class=\"row page_spacing-3\">\n\t<div class=\"col-md-3\"><img src=\"/images/FAQ/FAQ-02.png\" class=\"img-responsive center-block\" loading=\"lazy\"></div>\n    <div class=\"col-md-9\">\n    \t    \t<div class=\"news-title\">\n\n        \t\t<div class=\"row\">\n                    <div class=\"col-xs-2 col-md-2\"><img src=\"/images/FAQ/FAQ-09.png\" class=\"img-responsive center-block\" style=\"\" loading=\"lazy\"></div>\n                    <div class=\"col-xs-10 col-md-10\">هل خزانات الضغط بالديافراجم من AQUASKY مناسبة للاستخدام مع مياه الشرب؟</div>\n                </div>\n\n        </div>\n    \t<div id=\"collapse_qa_2\" aria-labelledby=\"qa_head_id_2\" >\n        \t<div class=\"news-content\">\n\t\t\t<p style=\"text-align: right;\"><span style=\"font-size:12px;\"><span style=\"font-family:Calibri,sans-serif\"><span lang=\"EN-US\"><span segoe=\"\" style=\"font-family:\" ui=\"\">نعم، يمكن استخدام خزانات الضغط بالديافراجم من AQUASKY في دائرة مائية صحية ويمكن أن تتواصل مع مياه الشرب.</span></span></span></span></p>            </div>\n        </div>\n\n    \t<div class=\"news-title\">\n\n        \t\t<div class=\"row\">\n                    <div class=\"col-xs-2 col-md-2\"><img src=\"/images/FAQ/FAQ-09.png\" class=\"img-responsive center-block\" style=\"\" loading=\"lazy\"></div>\n                    <div class=\"col-xs-10 col-md-10\">ما هو الضغط الأقصى للعمل لخزانات الضغط AQUASKY؟</div>\n                </div>\n\n        </div>\n    \t<div id=\"collapse_qa_5\" aria-labelledby=\"qa_head_id_5\" >\n        \t<div class=\"news-content\">\n\t\t\t<table class=\"MsoTableG