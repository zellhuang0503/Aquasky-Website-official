---
// 頁首：照舊站的 Bootstrap 3 navbar 結構（navbar-default → container → navbar-header + nav.navbar-collapse）。
// 下拉順序照舊站：PRODUCTS 連結 → 分隔線 → RESIDENTIAL／COMMERCIAL 子選單 → ACCESSORIES-PLUS → SELECTION TOOLS（zh 再多一個 ESG產品）。
// 舊站靠 jQuery + bootstrap.js 開關；這裡用下面的純 JS 做同樣的事（.open／.in class），一次只開一個。
import { brand, nav } from '../lib/data';
import { type Lang, href, t, languages } from '../lib/i18n';

interface Props { lang: Lang; /** 語系後路徑，語言切換時保留同一頁 */ path: string }
const { lang, path } = Astro.props;
const d = t(lang);
const label = (key: string) => (d.nav as Record<string, string>)[key] ?? key;
const forLang = <T extends { langs?: string[] }>(x: T) => !x.langs || x.langs.includes(lang);
const current = Astro.url.pathname.replace(/\.html$/, '');
const active = (p?: string) => (p !== undefined && current === href(lang, p) ? 'active' : undefined);
---
<header class="navbar navbar-default bs-docs-nav" role="banner">
  <div class="container">
    <div class="navbar-header">
      <button class="navbar-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="sr-only">{d.nav.menu}</span>
        <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
      </button>
      <a href={href(lang)} class="navbar-brand"><img src={brand.logo} alt={brand.brand} class="img-responsive" /></a>
    </div>
    <nav class="collapse navbar-collapse navbar-right bs-navbar-collapse" id="main-nav" role="navigation" aria-label={d.nav.menu}>
      <ul class="nav navbar-nav">
        {nav.items.map((item) =>
          item.children || item.groups ? (
            <li class={['dropdown', active(item.path)].filter(Boolean).join(' ')}>
              <a href="#" class="dropdown-toggle" role="button" aria-haspopup="true" aria-expanded="false">{label(item.key)} <b class="caret"></b></a>
              <ul class="dropdown-menu dropdown-menu-left">
                {item.path && (
                  <li class={active(item.path)}><a href={href(lang, item.path)}><i class="fas fa-chevron-right" aria-hidden="true"></i> {label(item.key)}</a></li>
                )}
                {item.path && item.groups && <li role="separator" class="divider"></li>}
                {item.groups?.map((g) => (
                  <li class="dropdown dropdown-submenu">
                    <a href="#" class="dropdown-toggle" role="button" aria-haspopup="true" aria-expanded="false"><i class="fas fa-chevron-right" aria-hidden="true"></i> {label(g.key)}</a>
                    <ul class="dropdown-menu dropdown-menu-left">
                      {g.children.filter(forLang).map((c) => (
                        <li class={active(c.path)}><a href={href(lang, c.path)}><i class="fas fa-chevron-right" aria-hidden="true"></i> {label(c.key)}</a></li>
                      ))}
                    </ul>
                  </li>
                ))}
                {item.children?.filter(forLang).map((c) => (
                  <li class={active(c.path)}><a href={href(lang, c.path)}><i class="fas fa-chevron-right" aria-hidden="true"></i> {label(c.key)}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li class={active(item.path)}><a href={href(lang, item.path!)}>{label(item.key)}</a></li>
          )
        )}
        <li class="dropdown">
          <a href="#" class="dropdown-toggle" role="button" aria-haspopup="true" aria-expanded="false">{d.nav.language} <b class="caret"></b></a>
          <ul class="dropdown-menu dropdown-menu-left">
            {languages.map((l) =>
              l.live ? (
                <li class={l.code === lang ? 'active' : undefined}><a href={href(l.code, path)} hreflang={l.htmlLang} lang={l.htmlLang}><i class="fas fa-chevron-right" aria-hidden="true"></i> {l.label}</a></li>
              ) : (
                <li><span class="lang-pending" lang={l.htmlLang} title={d.common.languageNotLive}>{l.label}</span></li>
              )
            )}
          </ul>
        </li>
      </ul>
    </nav>
    <div class="clearfix"></div>
  </div>
</header>
<script>
  // 取代 bootstrap.js：漢堡鈕切 .in；下拉切 .open；滑到別的選單、點外面或 Esc 都關掉其他的，一次只開一個。
  const toggle = document.querySelector<HTMLButtonElement>('.navbar-toggle');
  const collapse = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = !collapse?.classList.contains('in');
    collapse?.classList.toggle('in', open);
    toggle.setAttribute('aria-expanded', String(open));
  });
  const closeAll = (except?: Element | null) => {
    document.querySelectorAll('.navbar .dropdown.open').forEach((li) => {
      if (except && li.contains(except)) return;
      li.classList.remove('open');
      li.querySelector(':scope > a')?.setAttribute('aria-expanded', 'false');
    });
  };
  document.querySelectorAll<HTMLAnchorElement>('.navbar .dropdown-toggle').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const li = a.parentElement!;
      const open = !li.classList.contains('open');
      closeAll(li);
      li.classList.toggle('open', open);
      a.setAttribute('aria-expanded', String(open));
    });
  });
  document.querySelectorAll<HTMLElement>('.navbar .nav > li.dropdown').forEach((li) => {
    li.addEventListener('mouseenter', () => closeAll(li));
  });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.navbar .dropdown')) closeAll(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
</script>
