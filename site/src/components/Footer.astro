---
// 頁尾：照舊站 <footer><div class="container"><div id="footer-content">…。中文版多一行公司名（舊站 zh 也有）。
import { brand } from '../lib/data';
import { type Lang, t, pick } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<footer>
  <div class="container">
    <div id="footer-content">
      <p><img alt={brand.brand} class="img-responsive center-block" src={brand.footerLogo} width="200" height="60" loading="lazy" /></p>
      <p>www.aquaskyplus.com</p>
      {lang !== 'en' && <p>{pick(brand.legalName, lang)}</p>}
      <p>{pick(brand.address, lang)}</p>
      <p>{d.common.tel} {brand.tel} / {d.common.fax} {brand.fax}</p>
      <p>
        <a href={brand.sameAs[0]} style="color:#FFF;" target="_blank" rel="noopener">Facebook</a>
        {' '}
        <a href={brand.sameAs[1]} style="color:#FFF;" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </div>
  </div>
</footer>
