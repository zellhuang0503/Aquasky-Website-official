---
// 規格表：照舊站 table.series-spec 的欄位結構（第一列群組標題、第二列單位）。單位列不翻（禁譯清單）。
interface Row {
  model: string; volumeL: string; volumeGal: string; diameterCm: string; diameterIn: string;
  heightCm: string; heightIn: string; boxLengthCm: string; boxLengthIn: string; boxWidthCm: string; boxWidthIn: string;
  boxHeightCm: string; boxHeightIn: string; netWeightKg: string; netWeightLb: string; grossWeightKg: string; grossWeightLb: string;
  shippingVolumeCuf: string; connection: string;
}
interface Props {
  caption: string;
  columns: Record<'model' | 'volume' | 'diameter' | 'height' | 'boxLength' | 'boxWidth' | 'boxHeight' | 'netWeight' | 'grossWeight' | 'shippingVolume' | 'connection', string>;
  rows: Row[];
}
const { caption, columns: c, rows } = Astro.props;
// 數字照舊站原字串顯示（資料檔就是字串），不重新格式化
const pairs: [keyof typeof c, string, string][] = [
  ['volume', 'Liter', 'Gal'], ['diameter', 'Cm', 'Inch'], ['height', 'Cm', 'Inch'],
  ['boxLength', 'Cm', 'Inch'], ['boxWidth', 'Cm', 'Inch'], ['boxHeight', 'Cm', 'Inch'],
  ['netWeight', 'Kg', 'Lbs'], ['grossWeight', 'Kg', 'Lbs'],
];
---
<table class="series-spec">
  <caption>{caption}</caption>
  <thead>
    <tr>
      <th rowspan="2" scope="col">{c.model}</th>
      {pairs.map(([key]) => <th colspan="2" scope="colgroup">{c[key]}</th>)}
      <th scope="col">{c.shippingVolume}</th>
      <th rowspan="2" scope="col">{c.connection}</th>
    </tr>
    <tr>
      {pairs.map(([, a, b]) => (<Fragment><th scope="col" lang="en">{a}</th><th scope="col" lang="en">{b}</th></Fragment>))}
      <th scope="col" lang="en">CUF</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td>{r.model}</td>
        <td>{r.volumeL}</td><td>{r.volumeGal}</td>
        <td>{r.diameterCm}</td><td>{r.diameterIn}</td>
        <td>{r.heightCm}</td><td>{r.heightIn}</td>
        <td>{r.boxLengthCm}</td><td>{r.boxLengthIn}</td>
        <td>{r.boxWidthCm}</td><td>{r.boxWidthIn}</td>
        <td>{r.boxHeightCm}</td><td>{r.boxHeightIn}</td>
        <td>{r.netWeightKg}</td><td>{r.netWeightLb}</td>
        <td>{r.grossWeightKg}</td><td>{r.grossWeightLb}</td>
        <td>{r.shippingVolumeCuf}</td>
        <td>{r.connection}</td>
      </tr>
    ))}
  </tbody>
</table>
