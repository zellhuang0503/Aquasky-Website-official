---
// 照抄型頁面：舊站主體 HTML 整段輸出（src/content/legacy/<id>/<lang>.json 的 bodyHtml），頁面樣式照舊站（src/data/pages/<id>.json 的 legacyCss）。
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang, t } from '../lib/i18n';
import { nav } from '../lib/data';

interface Props { lang: Lang; page: CollectionEntry<'pages'>['data'] }
const { lang, page } = Astro.props;
const entry = await getEntry('legacy', `${page.id}/${lang}`);
if (!entry) throw new Error(`missing src/content/legacy/${page.id}/${lang}.json`);
const c = entry.data;
const d = t(lang);
// 麵包屑：從選單找這個路徑在哪。PRODUCTS 底下的系列頁 → 首頁›產品系列›X；其他頁 → 首頁›該頁選單字樣；products 本身 → 首頁›產品系列
const labelOf = (key: string) => (d.nav as Record<string, string>)[key] ?? key;
let crumb: { name: string; path: string }[] = [];
for (const item of nav.items) {
  if (!crumb.length && item.path === page.path) crumb = [{ name: labelOf(item.key), path: page.path }];
  for (const c2 of item.children ?? []) if (!crumb.length && c2.path === page.path) crumb = item.key === 'products' ? [{ name: labelOf('products'), path: '/products' }, { name: labelOf(c2.key), path: page.path }] : [{ name: labelOf(c2.key), path: page.path }];
  for (const g of item.groups ?? []) for (const c3 of g.children) if (!crumb.length && c3.path === page.path) crumb = [{ name: labelOf('products'), path: '/products' }, { name: labelOf(c3.key), path: page.path }];
}
// 產品明細（/products-det/<series>/<model>）：首頁›產品系列›該系列›型號；配件明細：首頁›產品系列›安裝配件›品名
const detail = page.path.match(/^\/(products-det|accessories-det)\/([^/]+)/);
if (detail) {
  const seriesPath = detail[1] === 'accessories-det' ? '/accessories' : `/${detail[2]}`;
  let seriesCrumb: { name: string; path: string } | null = null;
  for (const item of nav.items) {
    for (const c2 of item.children ?? []) if (c2.path.toLowerCase() === seriesPath.toLowerCase()) seriesCrumb = { name: labelOf(c2.key), path: c2.path };
    for (const g of item.groups ?? []) for (const c3 of g.children) if (c3.path.toLowerCase() === seriesPath.toLowerCase()) seriesCrumb = { name: labelOf(c3.key), path: c3.path };
  }
  if (!seriesCrumb) throw new Error(`${page.path}: series ${seriesPath} not in nav`);
  crumb = [{ name: labelOf('products'), path: '/products' }, seriesCrumb, { name: c.h1, path: page.path }];
}
// 單張認證頁（/certification-page/<slug>）：首頁›CERTIFICATION›該認證
if (page.path.startsWith('/certification-page/')) crumb = [{ name: labelOf('certification'), path: '/certification' }, { name: c.h1, path: page.path }];
// 下載子頁（/download/<language>）：首頁›DOWNLOAD›EDM English
if (page.neutral && page.path.startsWith('/download/')) crumb = [{ name: labelOf('download'), path: '/downloadpage' }, { name: c.subtitle ?? c.h1, path: page.path }];
if (!crumb.length) crumb = [{ name: c.h1, path: page.path }];
const breadcrumbs = [{ name: d.common.breadcrumbHome, path: '' }, ...crumb];
const image = page.assets.find((a) => /\.(png|jpe?g|webp)$/i.test(a));
---
<Base lang={lang} title={c.seo.title} description={c.seo.description} path={page.path} image={image} jsonLd={c.legacyJsonLd} breadcrumbs={breadcrumbs} bootstrap={page.bootstrap} extraCss={page.extraCss} headStyle={page.legacyCss} noLangPrefix={page.neutral} alternates={page.neutral ? [] : page.langs}>
  {!c.hasVisibleH1 && <h1 class="visually-hidden">{c.h1}</h1>}
  <Fragment set:html={c.bodyHtml} />
  {page.id === 'feature' && (
    <script is:inline>
      // 舊站 feature 頁的 jQuery：點 .feature_obj 時把六個說明面板全部藏起來，只顯示 obj_id_name 指到的那個（hover 覆蓋圖是 CSS）
      document.querySelectorAll('.feature_obj').forEach(function (el) {
        el.addEventListener('click', function () {
          document.querySelectorAll('.obj_ev_item').forEach(function (p) { p.style.display = 'none'; });
          var target = document.getElementById(el.getAttribute('obj_id_name'));
          if (target) target.style.display = 'block';
        });
      });
    </script>
  )}
</Base>
