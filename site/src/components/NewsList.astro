---
// 新聞列表頁（/news/EXHIBITIONS、/news/INDUSTRY、/news/<CAT>/pageN）：標記照舊站，每頁 5 篇，右欄固定幾篇「熱門文章」，分頁列出全部頁碼。
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import common from '../data/news/common.json';
import brand from '../data/brand.json';
import { type Lang, t } from '../lib/i18n';

interface Props {
  lang: Lang;
  list: CollectionEntry<'newsLists'>['data'];
  /** 第幾頁（1 起算） */
  page: number;
  /** 這一頁在哪些語系也有（hreflang 只列這些） */
  alternates: Lang[];
}
const { lang, list, page, alternates } = Astro.props;
if (page < 1 || page > list.pageCount) throw new Error(`${list.id}: page ${page} out of range`);
const d = t(lang);
const basePath = list.path;
const pagePath = (n: number) => (n === 1 ? basePath : `${basePath}/page${n}`);
const path = pagePath(page);

const all = await getCollection('news', (e) => e.data.lang === lang && e.data.category === list.category);
const bySlug = new Map(all.map((e) => [e.data.slug, e.data]));
const slugs = list.order.slice((page - 1) * list.perPage, page * list.perPage);
const items = slugs.map((s) => { const a = bySlug.get(s); if (!a) throw new Error(`${list.id}: article ${s} missing`); return a; });

const catLabel = (d.nav as Record<string, string>)[list.category.toLowerCase()] ?? list.category;
// 新聞：首頁›最新消息›分類；影片：首頁›影片專區
const breadcrumbs = list.kind === 'news'
  ? [{ name: d.common.breadcrumbHome, path: '' }, { name: d.nav.news, path: basePath }, { name: catLabel, path: basePath }]
  : [{ name: d.common.breadcrumbHome, path: '' }, { name: d.nav.videos, path: basePath }];
const site = brand.url;
const jsonLd = [{
  '@type': 'CollectionPage',
  '@id': `${site}/${lang}${path}#webpage`,
  url: `${site}/${lang}${path}`,
  name: list.seo.title,
  isPartOf: { '@id': `${site}/#website` },
  publisher: { '@id': `${site}/#organization` },
}];
const pages = Array.from({ length: list.pageCount }, (_, i) => i + 1);
---
<Base lang={lang} title={list.seo.title} description={list.seo.description} path={path} image={items[0]?.cover} jsonLd={jsonLd} breadcrumbs={breadcrumbs} alternates={alternates} bootstrap="full" headStyle={common.listCss} bodyData={{ backKey: `${list.kind}_back` }}>
  <h1 class="visually-hidden">{list.titleBand}</h1>
  <!--about-container-01-->
  <div id="news-container" class="container-fluid">
    <div id="about-top-title">{list.titleBand}</div>
    <div class="container page_spacing lang_rtl">
      <div class="row">
        <div class="col-md-8 block-bg-01">
          <h4 class="news-h4">{list.h4Recent}</h4>
          {items.map((a) => (
            <Fragment>
              <div class="row news-item">
                <div class="col-md-6 block-bg-03">
                  <p class="news-time-style-1">{a.dateText}</p>
                  <div class="news-img-border"><a href={`/${lang}${a.path}`}><img src={a.cover} alt={a.title} loading="lazy" class="img-responsive" /></a></div>
                </div>
                <div class="col-md-6 block-bg-04">
                  <p class="news-title-style"><a href={`/${lang}${a.path}`}>{a.title}</a></p>
                  <div class="news-text" set:html={a.excerptHtml} />
                </div>
              </div>
              <div class="text-right news-item-more"><a href={`/${lang}${a.path}`}>{list.moreLabel}</a></div>
            </Fragment>
          ))}
          {list.pageCount > 1 && (
            <div class="news_chg_page"><nav><ul class="pagination">
              {page === 1
                ? <li class="disabled"><a href="#"><span aria-hidden="true">&laquo;</span><span class="sr-only">Previous</span></a></li>
                : <li><a href={`/${lang}${pagePath(page - 1)}`}><span aria-hidden="true">&laquo;</span><span class="sr-only">Previous</span></a></li>}
              {pages.map((n) => n === page
                ? <li class="active"><a href="#">{n}</a></li>
                : <li><a href={`/${lang}${pagePath(n)}`}>{n}</a></li>)}
              {page === list.pageCount
                ? <li class="disabled"><a href="#"><span aria-hidden="true">&raquo;</span><span class="sr-only">Next</span></a></li>
                : <li><a href={`/${lang}${pagePath(page + 1)}`}><span aria-hidden="true">&raquo;</span><span class="sr-only">Next</span></a></li>}
            </ul></nav></div>
          )}
        </div>
        <div class="col-md-4 block-bg-02">
          <h4 class="news-h4">{list.h4Side}</h4>
          {list.sidebar.map((s) => (
            <div class="news-right-list"><p class="news-time-style-1">{s.dateText}</p><p class="news-right-list-title"><a href={s.href}>{s.title}</a></p></div>
          ))}
        </div>
      </div>
    </div>
    <!--end container-01-->
  </div>
  <!--end news-container-01-->
  <script is:inline>
    // 舊站：記住從哪個列表頁進明細，明細頁的「返回」才能回到同一頁（新聞 news_back、影片 videos_back）
    try { sessionStorage.setItem(document.body.dataset.backKey, location.href); } catch (e) {}
  </script>
</Base>
