---
// 產品系列清單：照舊站 row/col-md-6 兩欄 + .pd-btn-info-link 圓角按鈕。
// 首頁 variant="home"（大圖、btn-link）；系列頁底部 variant="series"（webp 小圖、btn-link2）。
import nav from '../data/nav.json';
import { type Lang, href, t } from '../lib/i18n';
interface Props { lang: Lang; variant?: 'home' | 'series' }
const { lang, variant = 'home' } = Astro.props;
const d = t(lang);
const label = (key: string) => (d.nav as Record<string, string>)[key] ?? key;
const btn = variant === 'home' ? 'btn btn-link' : 'btn btn-link2';
const list = nav.productLine;
const rows: typeof list[] = [];
for (let i = 0; i < list.length; i += 2) rows.push(list.slice(i, i + 2));
---
{rows.map((row) => (
  <div class="row padding_top_40">
    {row.map((p) => (
      <div class="col-lg-6 col-md-6 col-sm-6">
        <img src={variant === 'home' ? p.image : p.thumb} class="img-responsive center-block" alt={label(p.key)} loading="lazy" />
        <div class="pd-btn-info-link" style={p.also ? 'word-break: break-all;' : undefined}>
          <a href={href(lang, p.path)} class={btn} style={p.also ? 'margin-bottom:5px;' : undefined}>{label(p.key)}</a>
          {p.also && <a href={href(lang, p.also.path)} class={btn} style="margin-bottom:5px;">{label(p.also.key)}</a>}
        </div>
      </div>
    ))}
  </div>
))}
