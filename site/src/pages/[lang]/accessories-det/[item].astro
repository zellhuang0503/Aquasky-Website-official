---
// 配件明細：/en/accessories-det/<item>（舊站只有英文版；照抄模板）
import { getCollection } from 'astro:content';
import LegacyPage from '../../../components/LegacyPage.astro';
import { type Lang, liveLangs } from '../../../lib/i18n';

export async function getStaticPaths() {
  const pages = (await getCollection('pages')).map((e) => e.data).filter((p) => p.path.startsWith('/accessories-det/'));
  return pages.flatMap((page) => {
    const [, , item] = page.path.split('/');
    return page.langs.filter((l) => liveLangs.includes(l)).map((lang) => ({ params: { lang, item }, props: { page } }));
  });
}
const { page } = Astro.props;
---
<LegacyPage lang={Astro.params.lang as Lang} page={page} />
