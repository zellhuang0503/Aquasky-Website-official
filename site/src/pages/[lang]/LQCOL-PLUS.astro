---
// LQCOL-PLUS 系列頁：/en/LQCOL-PLUS、/zh/LQCOL-PLUS（網址與舊站相同）。
// 文字：src/content/series/lqcol-plus/<lang>.json；數字：src/data/products/lqcol-plus.json。
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductLine from '../../components/ProductLine.astro';
import SpecTable from '../../components/SpecTable.astro';
import product from '../../data/products/lqcol-plus.json';
import brand from '../../data/brand.json';
import { type Lang, liveLangs, t } from '../../lib/i18n';

export function getStaticPaths() {
  return liveLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const entry = await getEntry('series', `lqcol-plus/${lang}`);
if (!entry) throw new Error(`missing src/content/series/lqcol-plus/${lang}.json`);
const c = entry.data;
const d = t(lang);
const site = brand.url;
const pageUrl = `${site}/${lang}${product.path}`;
const s = c.specs;
const mb = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const downloads = product.downloads.map((dl) => ({ ...dl, title: dl.key === 'brochure' ? c.downloads.brochure : c.downloads.manual }));

// JSON-LD：ProductGroup（系列）＋每個型號一個 Product；FAQPage。數字全部從 product JSON 來，跟表格同一份。
const allModels = [
  ...product.specs.carbonSteel.map((m) => ({ ...m, material: s.captionCarbon, maxTemp: product.specs.common.maxWorkingTempCarbon })),
  ...product.specs.stainlessSteel.map((m) => ({ ...m, material: s.captionStainless, maxTemp: product.specs.common.maxWorkingTempStainless })),
];
const productGroup = {
  '@type': 'ProductGroup',
  '@id': `${pageUrl}#series`,
  name: `${brand.brand} ${product.series}`,
  description: c.about.body,
  url: pageUrl,
  image: `${site}${product.images.hero}`,
  brand: { '@type': 'Brand', name: brand.brand },
  manufacturer: { '@id': `${site}/#organization` },
  productGroupID: product.series,
  variesBy: ['https://schema.org/size', 'https://schema.org/material'],
  hasVariant: allModels.map((m) => ({
    '@type': 'Product',
    name: `${brand.brand} ${product.series} ${m.model}`,
    sku: m.model,
    model: m.model,
    material: m.material,
    size: `${m.volumeL} L`,
    weight: { '@type': 'QuantitativeValue', value: m.netWeightKg, unitCode: 'KGM' },
    additionalProperty: [
      { '@type': 'PropertyValue', name: s.columns.volume, value: m.volumeL, unitCode: 'LTR' },
      { '@type': 'PropertyValue', name: s.columns.diameter, value: m.diameterCm, unitCode: 'CMT' },
      { '@type': 'PropertyValue', name: s.columns.height, value: m.heightCm, unitCode: 'CMT' },
      { '@type': 'PropertyValue', name: s.columns.connection, value: m.connection },
      { '@type': 'PropertyValue', name: s.props.factoryPrecharge, value: product.specs.common.factoryPrecharge },
      { '@type': 'PropertyValue', name: s.props.maxWorkingPressure, value: product.specs.common.maxWorkingPressure },
      { '@type': 'PropertyValue', name: s.props.maxWorkingTemp, value: m.maxTemp },
    ],
  })),
};
const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbs = [
  { name: d.common.breadcrumbHome, path: '' },
  { name: d.nav.products, path: '/products' },
  { name: d.nav['LQCOL-PLUS'], path: product.path },
];
---
<Base lang={lang} title={c.seo.title} description={c.seo.description} path={product.path} image={product.images.hero} jsonLd={[productGroup, faqPage]} breadcrumbs={breadcrumbs}>
  <nav class="wrap breadcrumbs" aria-label="breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>{i < breadcrumbs.length - 1 ? <a href={`/${lang}${b.path}`}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>
      ))}
    </ol>
  </nav>

  <section class="series-hero">
    <div class="wrap series-hero-inner">
      <div class="series-hero-text">
        <img class="series-logo" src={product.images.logo} alt={product.series} width="320" height="90" />
        <h1>{c.h1}</h1>
        {c.status === 'draft-ai' && <p class="draft-note" role="note">{lang === 'zh' ? '本頁中文為 AI 初稿，尚待審稿。' : 'Draft translation, pending review.'}</p>}
      </div>
      <img class="series-hero-img" src={product.images.hero} alt={`${brand.brand} ${product.series}`} loading="eager" fetchpriority="high" />
    </div>
  </section>

  <div class="wrap series-body">
    <section class="series-sec" aria-labelledby="about">
      <h2 id="about">{c.about.heading}</h2>
      <p class="lead">{c.about.body}</p>
    </section>

    <section class="series-sec" aria-labelledby="features">
      <h2 id="features">{c.features.heading}</h2>
      <div class="feature-groups">
        {c.features.groups.map((g) => (
          <div class="feature-group">
            <h3 class="feature-tag">{g.label}</h3>
            <ul>
              {g.items.map((it) => <li>{it.lead && <strong>{it.lead}</strong>}{it.lead && (lang === 'zh' ? '：' : ': ')}{it.text}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <figure class="structure">
        <img src={product.images.structure} alt={c.structure.alt} loading="lazy" />
        <figcaption>
          <ol class="structure-legend">
            {c.structure.labels.map((l) => <li>{l}</li>)}
          </ol>
        </figcaption>
      </figure>
    </section>

    <section class="series-sec" aria-labelledby="applications">
      <h2 id="applications">{c.applications.heading}</h2>
      <img class="app-img" src={product.images.applications} alt={c.applications.alt} loading="lazy" />
      <ul class="app-list">
        {c.applications.items.map((it) => <li>{it.lead && <strong>{it.lead}</strong>}{it.lead && (lang === 'zh' ? '：' : ': ')}{it.text}</li>)}
      </ul>
    </section>

    <section class="series-sec" aria-labelledby="specs">
      <h2 id="specs">{s.heading}</h2>
      <p class="spec-title">{s.tableTitle}</p>
      <SpecTable caption={s.captionCarbon} columns={s.columns} rows={product.specs.carbonSteel} />
      <SpecTable caption={s.captionStainless} columns={s.columns} rows={product.specs.stainlessSteel} />
      <table class="prop-table">
        <tbody>
          <tr><th scope="row">{s.props.shell}</th><td>{s.props.shellValue}</td></tr>
          <tr><th scope="row">{s.props.systemConnection}</th><td>{s.props.systemConnectionValue}</td></tr>
          <tr><th scope="row">{s.props.coating}</th><td>{s.props.coatingValue}</td></tr>
          <tr><th scope="row">{s.props.diaphragm}</th><td>{s.props.diaphragmValue}</td></tr>
          <tr><th scope="row">{s.props.factoryPrecharge}</th><td>{product.specs.common.factoryPrecharge}</td></tr>
          <tr><th scope="row">{s.props.maxWorkingTemp}</th><td>{s.props.maxWorkingTempCarbon}<br />{s.props.maxWorkingTempStainless}</td></tr>
          <tr><th scope="row">{s.props.maxWorkingPressure}</th><td>{product.specs.common.maxWorkingPressure}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="series-sec" aria-labelledby="faq">
      <h2 id="faq">{c.faq.heading}</h2>
      <div class="faq-list">
        {c.faq.items.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary><h3>{`Q${i + 1}. ${f.q}`}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="series-sec" aria-labelledby="download">
      <h2 id="download">{c.downloads.heading}</h2>
      <ul class="download-list">
        {downloads.map((dl) => (
          <li>
            <a href={dl.pdf} class="download-card" type="application/pdf">
              <img src={dl.cover} alt="" loading="lazy" />
              <span class="download-title">{dl.title}</span>
              <span class="download-meta">PDF · {mb(dl.sizeBytes)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <ProductLine lang={lang} heading={c.productLineHeading} variant="compact" />
  </div>
</Base>
