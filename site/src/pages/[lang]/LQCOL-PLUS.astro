---
// LQCOL-PLUS 系列頁：/en/LQCOL-PLUS、/zh/LQCOL-PLUS。HTML 結構與 class 照舊站同頁（h1 條 → #pd-container-01 深底
// → series-sec 區塊 → #pd-more-info 產品列 → footer）。文字：src/content/series/lqcol-plus/<lang>.json；數字：src/data/products/lqcol-plus.json。
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductLine from '../../components/ProductLine.astro';
import SpecTable from '../../components/SpecTable.astro';
import { brand } from '../../lib/data';
import { type Lang, liveLangs, t } from '../../lib/i18n';
import { bold, br } from '../../lib/text';

export function getStaticPaths() {
  return liveLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const entry = await getEntry('series', `lqcol-plus/${lang}`);
if (!entry || entry.data.template !== 'lqcol') throw new Error(`missing lqcol content src/content/series/lqcol-plus/${lang}.json`);
const c = entry.data;
const productEntry = await getEntry('products', 'lqcol-plus');
if (!productEntry || productEntry.data.template !== 'lqcol') throw new Error('missing src/data/products/lqcol-plus.json');
const product = productEntry.data;
const d = t(lang);
const site = brand.url;
const pageUrl = `${site}/${lang}${product.path}`;
const s = c.specs;
const fig = product.structureFigure;
const colon = lang === 'zh' ? '：' : ': ';
const answerPrefix = lang === 'zh' ? 'A：' : 'A:';
const downloads = product.downloads.map((dl) => ({ ...dl, title: dl.key === 'brochure' ? c.downloads.brochure : c.downloads.manual }));

// JSON-LD：ProductGroup（系列）＋每個型號一個 Product；FAQPage。數字全部從 product JSON 來，跟表格同一份。
const allModels = [
  ...product.specs.carbonSteel.map((m) => ({ ...m, material: s.captionCarbon, maxTemp: product.specs.common.maxWorkingTempCarbon })),
  ...product.specs.stainlessSteel.map((m) => ({ ...m, material: s.captionStainless, maxTemp: product.specs.common.maxWorkingTempStainless })),
];
const productGroup = {
  '@type': 'ProductGroup',
  '@id': `${pageUrl}#series`,
  name: `${brand.brand} ${product.series}`,
  description: c.about.body.replace(/\*\*/g, ''),
  url: pageUrl,
  image: `${site}${product.images.hero}`,
  brand: { '@type': 'Brand', name: brand.brand },
  manufacturer: { '@id': `${site}/#organization` },
  productGroupID: product.series,
  variesBy: ['https://schema.org/size', 'https://schema.org/material'],
  hasVariant: allModels.map((m) => ({
    '@type': 'Product',
    name: `${brand.brand} ${product.series} ${m.model}`,
    sku: m.model,
    model: m.model,
    material: m.material,
    size: `${m.volumeL} L`,
    weight: { '@type': 'QuantitativeValue', value: Number(m.netWeightKg), unitCode: 'KGM' },
    additionalProperty: [
      { '@type': 'PropertyValue', name: s.columns.volume, value: Number(m.volumeL), unitCode: 'LTR' },
      { '@type': 'PropertyValue', name: s.columns.diameter, value: Number(m.diameterCm), unitCode: 'CMT' },
      { '@type': 'PropertyValue', name: s.columns.height, value: Number(m.heightCm), unitCode: 'CMT' },
      { '@type': 'PropertyValue', name: s.columns.connection, value: m.connection },
      { '@type': 'PropertyValue', name: s.props.factoryPrecharge, value: product.specs.common.factoryPrecharge },
      { '@type': 'PropertyValue', name: s.props.maxWorkingPressure, value: product.specs.common.maxWorkingPressure },
      { '@type': 'PropertyValue', name: s.props.maxWorkingTemp, value: m.maxTemp },
    ],
  })),
};
const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\*\*/g, '') } })),
};
const breadcrumbs = [
  { name: d.common.breadcrumbHome, path: '' },
  { name: d.nav.products, path: '/products' },
  { name: d.nav['LQCOL-PLUS'], path: product.path },
];
---
<Base lang={lang} title={c.seo.title} description={c.seo.description} path={product.path} image={product.images.hero} jsonLd={[productGroup, faqPage]} breadcrumbs={breadcrumbs} headStyle={product.legacyCss}>
  <div class="h1-custom-style">
    <h1>{c.h1}</h1>
    {c.status === 'draft-ai' && <div class="draft-note" role="note">{lang === 'zh' ? '本頁中文為 AI 初稿，尚待審稿。' : 'Draft translation, pending review.'}</div>}
  </div>

  <div id="pd-container-01" class="container-fluid">
    <div class="container series-wrap">
      <div class="pd-aquasky-text"><img src={product.images.logo} class="img-responsive center-block" alt={product.series} /></div>
      <div class="pd-aquasky-LQCOL-all"><img src={product.images.hero} class="img-responsive center-block" alt={`${product.series} ${c.h1}`} /></div>

      <section class="series-sec lang_rtl">
        <h2 class="series-title">{c.about.heading}</h2>
        <div class="series-content"><p set:html={bold(c.about.body)} /></div>
      </section>

      <section class="series-sec lang_rtl">
        <h2 class="series-title">{c.features.heading}</h2>
        <div class="series-content">
          <div class="series-feat">
            {c.features.groups.map((g) => (
              <div class="series-feat-item">
                <div class="series-feat-tag">{g.label}</div>
                <div class="series-feat-box">
                  {g.items.map((it) => <p>• {it.lead && <Fragment><strong>{it.lead}</strong>{colon}</Fragment>}<Fragment set:html={bold(it.text)} /></p>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="series-sec lang_rtl">
        <div class="series-content">
          <div class="series-figure" data-figure="lqc-structure">
            <div class="sf-stage" style={`padding-top:${fig.stagePaddingTop};--sf-font:${fig.font};`}>
              <img class="sf-img" src={product.images.structure} alt={c.structure.alt} loading="lazy" style={`left:${fig.img.left};top:${fig.img.top};width:${fig.img.width};`} />
              <svg class="sf-lines" viewBox={fig.viewBox} preserveAspectRatio="none" aria-hidden="true">
                {fig.lines.map((l) => (
                  <Fragment>
                    <polyline points={l.points} />
                    {l.dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.2" />)}
                  </Fragment>
                ))}
              </svg>
              {c.structure.labels.map((text, i) => (
                <div class={`sf-label${fig.labels[i].center ? ' sf-center' : ''}`} style={`left:${fig.labels[i].left};top:${fig.labels[i].top};`} set:html={br(text)} />
              ))}
            </div>
            <div class="sf-mobile">
              <div class="sf-mimg">
                <img src={product.images.structure} alt={c.structure.alt} loading="lazy" />
                {fig.mobileMarkers.map((m, i) => <span class="sf-marker" style={`left:${m.left};top:${m.top};`}>{i + 1}</span>)}
              </div>
              <ol class="sf-list">{c.structure.labels.map((text) => <li>{text.replace(/\n/g, ' ')}</li>)}</ol>
            </div>
          </div>
        </div>
      </section>

      <section class="series-sec lang_rtl">
        <h2 class="series-title">{c.applications.heading}</h2>
        <div class="series-content">
          <p style="text-align: center;"><img src={product.images.applications} alt={c.applications.alt} width="653" height="223" loading="lazy" /></p>
          <div class="series-app-box">
            {[c.applications.items.slice(0, 3), c.applications.items.slice(3)].map((col) => (
              <div class="series-app-col">
                {col.map((it) => <p><strong>• {it.lead}{it.lead && !it.lead.endsWith(',') && (lang === 'zh' ? '：' : ':')}</strong> {it.text}</p>)}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="series-sec lang_rtl">
        <h2 class="series-title">{s.heading}</h2>
        <div class="series-content">
          <div class="series-spec-box">
            <p class="series-spec-head">{s.tableTitle}</p>
            <SpecTable caption={s.captionCarbon} columns={s.columns} rows={product.specs.carbonSteel} />
            <SpecTable caption={s.captionStainless} columns={s.columns} rows={product.specs.stainlessSteel} />
          </div>
          <table class="series-prop">
            <tbody>
              <tr><td>{s.props.shell}</td><td>{s.props.shellValue}</td></tr>
              <tr><td>{s.props.systemConnection}</td><td>{s.props.systemConnectionValue}</td></tr>
              <tr><td>{s.props.coating}</td><td>{s.props.coatingValue}</td></tr>
              <tr><td>{s.props.diaphragm}</td><td>{s.props.diaphragmValue}</td></tr>
              <tr><td>{s.props.factoryPrecharge}</td><td>{product.specs.common.factoryPrecharge}</td></tr>
              <tr><td rowspan="2">{s.props.maxWorkingTemp}</td><td>{s.props.maxWorkingTempCarbon}</td></tr>
              <tr><td>{s.props.maxWorkingTempStainless}</td></tr>
              <tr><td>{s.props.maxWorkingPressure}</td><td>{product.specs.common.maxWorkingPressure}</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="series-sec lang_rtl">
        <h2 class="series-title">{c.faq.heading}</h2>
        {c.faq.items.map((f, i) => (
          <div class="series-faq-item">
            <h3>{`Q${i + 1}${colon}${f.q}`}</h3>
            <div class="series-content"><p><strong>{answerPrefix}</strong> <Fragment set:html={bold(f.a)} /></p></div>
          </div>
        ))}
      </section>

      <section class="series-sec">
        <h2 class="series-title">{c.downloads.heading}</h2>
        <div class="series-dl">
          {downloads.map((dl) => (
            <div class="series-dl-item">
              <a class="series-dl-title" href={dl.pdf} target="_blank" rel="noopener">{dl.title}</a>
              <a href={dl.pdf} target="_blank" rel="noopener"><img src={dl.cover} alt={dl.title} loading="lazy" /></a>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div id="pd-more-info" class="container">
      <h2 class="h2_2hline h2_2hline_margin lang_rtl">{c.productLineHeading}</h2>
      <div id="other_pd_line" class="container">
        <ProductLine lang={lang} variant="series" />
        <div class="pd-spacing-01"></div>
      </div>
    </div>
  </div>
</Base>
