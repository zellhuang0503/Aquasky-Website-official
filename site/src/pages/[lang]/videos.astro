---
// 影片列表第 1 頁：/en/videos、/zh/videos（第 2 頁起在 videos/[page].astro；版型與新聞列表相同）
import { getCollection } from 'astro:content';
import NewsList from '../../components/NewsList.astro';
import { type Lang, liveLangs } from '../../lib/i18n';

export async function getStaticPaths() {
  const lists = (await getCollection('newsLists')).map((e) => e.data).filter((l) => l.kind === 'videos');
  return lists.filter((l) => liveLangs.includes(l.lang)).map((list) => ({
    params: { lang: list.lang },
    props: { list, alternates: lists.filter((o) => liveLangs.includes(o.lang)).map((o) => o.lang) },
  }));
}
const { list, alternates } = Astro.props;
---
<NewsList lang={Astro.params.lang as Lang} list={list} page={1} alternates={alternates} />
