---
// 下載專區各語系子頁：/download/english、/download/chinese …（舊站網址沒有語系前綴，介面一律英文；照抄模板）
import { getCollection } from 'astro:content';
import LegacyPage from '../../components/LegacyPage.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('pages')).map((e) => e.data).filter((p) => p.neutral && p.path.startsWith('/download/'));
  return pages.map((page) => ({ params: { language: page.path.slice('/download/'.length) }, props: { page } }));
}
const { page } = Astro.props;
---
<LegacyPage lang="en" page={page} />
