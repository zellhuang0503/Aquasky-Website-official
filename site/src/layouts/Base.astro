---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import brand from '../data/brand.json';
import { type Lang, langInfo, t, stage } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
}
const props = Astro.props;
const info = langInfo(props.lang);
const d = t(props.lang);
---
<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#006da7" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="icon" href={brand.logo} type="image/png" />
    <Seo {...props} />
    {stage === 'production' && (
      <Fragment>
        {/* GA4：沿用舊站評估 ID，新舊站流量連續。只在 SITE_STAGE=production 輸出，預覽不灌數據。 */}
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${brand.ga4}`}></script>
        <script is:inline define:vars={{ id: brand.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.common.skipToContent}</a>
    {stage === 'preview' && <div class="preview-banner" role="note">PREVIEW · {new Date().toISOString().slice(0, 10)}</div>}
    <Header lang={props.lang} path={props.path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={props.lang} />
  </body>
</html>
