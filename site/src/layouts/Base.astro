---
// 版型外框。CSS 順序照舊站：bootstrap → style.css → series_content.css → a-hover.css，最後才是新站補充的 site.css。
import '../styles/site.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import brand from '../data/brand.json';
import { type Lang, langInfo, t, stage } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
  /** 系列頁等會在頁首下方自己放 h1 的頁面 */
  bodyClass?: string;
  /** 這一頁額外要載的舊站 CSS（例如經典系列頁的 /css/bootstrap-grid.min.css） */
  extraCss?: string[];
  /** 舊站寫在頁面 <style> 裡的頁面專用樣式，照抄 */
  headStyle?: string;
}
const props = Astro.props;
const info = langInfo(props.lang);
const d = t(props.lang);
---
<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#006da7" />
    <link rel="icon" href={brand.logo} type="image/png" />
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <link href="/css/series_content.css" rel="stylesheet" />
    <link href="/css/a-hover.css" rel="stylesheet" />
    {props.extraCss?.map((href) => <link href={href} rel="stylesheet" />)}
    {props.headStyle && <style is:inline set:html={props.headStyle} />}
    <Seo {...props} />
    {stage === 'production' && (
      <Fragment>
        {/* GA4：沿用舊站評估 ID，新舊站流量連續。只在 SITE_STAGE=production 輸出，預覽不灌數據。 */}
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${brand.ga4}`}></script>
        <script is:inline define:vars={{ id: brand.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </Fragment>
    )}
  </head>
  <body class={props.bodyClass}>
    <a class="skip-link" href="#main">{d.common.skipToContent}</a>
    {stage === 'preview' && <div class="preview-banner" role="note">PREVIEW · {new Date().toISOString().slice(0, 10)}</div>}
    <Header lang={props.lang} path={props.path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={props.lang} />
  </body>
</html>
